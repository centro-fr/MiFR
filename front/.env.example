VITE_GOOGLE_CLIENT_ID=
# Con "true" el front responde con los mocks de MSW en lugar de la API real.
VITE_USE_MOCKS=false
# Solo desarrollo: con "true" el login pide un email en lugar de Google.
# Necesita LOGIN_DESARROLLO=true en back/.env.
VITE_LOGIN_DESARROLLO=false

# URL del Servidor de Aplicaciones (back). La usa el Web Server del front
# para reenviar /api; el navegador nunca le pega directo al back.
API_URL="http://localhost:3000"
