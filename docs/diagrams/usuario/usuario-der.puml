@startuml "Usuario - DER"

!theme plain
hide circle
skinparam linetype ortho

' Solo existe para los que se logueen en google (propietaria, profesora, alumnos/tutores), google_id queda NULL hasta el primer login. 
entity "Usuario" {
    * id_usuario : int <<PK>>
    --
    google_id : string <<UK>>
    email : string
    nombre_completo : string
    dni : string <<UK>>
    telefono : string
    fecha_nacimento : date
    estado : string
    fecha_alta : date
}

' El rol que va a tener el login (PROPIETARIA, PROFESOR, ALUMNO)
entity "Perfil" {
    * id_perfil : int <<PK>>
    --
    * id_usuario : int <<FK>>
    rol: string
    fecha_asignacion : datetime
    estado : string
}

' La persona que efectivamente entrena, con sus datos propios (peso, talla, contacto de emergencia, etc). 
entity "Alumno" {
    * id_alumno : int <<PK>>
    --
    * dni : string <<UK>>
    fecha_nacimiento : date
    contacto_emergencia : string
    peso : decimal
    talla : decimal
    id_usuario_responsable : int <<FK>>
    estado : string
    fecha_alta : datetime
}

Usuario ||-right-o{ Perfil : "posee"
Usuario |o-down-o{ Alumno : "es responsable de"

@enduml