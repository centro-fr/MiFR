@startuml Vista_Arquitectonica_MiFR
title Vista Arquitectonica del Diseno - Centro de Entrenamiento FR

skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam nodesep 25
skinparam ranksep 45

skinparam package {
  BorderColor #495057
  FontColor #212529
  FontStyle bold
  BackgroundColor #EEFBF4 #DDF7EC
  BackgroundColor<<subsystem>> #FBEFEF
  BackgroundColor<<subsystem>> #F3FDF8 #F3FDF8
}

skinparam component {
  BackgroundColor #FBEAEA
  BorderColor #495057
  FontColor #212529

  BackgroundColor #EEFBF4 #EEFBF4
  BackgroundColor<<process>> #F4F6D2
  BackgroundColor<<external>> #BFDDF2
  BorderColor<<external>> #1971C2
}

skinparam interface {
  BackgroundColor #E9ECEF
  BorderColor #495057
  FontSize 10
}

skinparam note {
  BackgroundColor #FEF9E7
  BorderColor #F59F00
  FontSize 9
}

' ============================================================
' 1. CAPA PRESENTACION
' ============================================================
package "Capa Presentacion" as CapaPresentacion <<subsystem>> #FDE6D6 {
  component "UsuarioPresWeb"                as UsuarioPresWeb
  component "ServicioEntrenamientoPresWeb"  as ServicioEntrenamientoPresWeb
  component "PersonasPresWeb"               as PersonasPresWeb
  component "InscripcionYClasesPresWeb"     as InscripcionYClasesPresWeb
  component "HonorariosPresWeb"             as HonorariosPresWeb
  component "CuotasPagosPresWeb"            as CuotasPagosPresWeb
  component "RutinasPresWeb"                as RutinasPresWeb
  component "NotificacionesPresWeb"         as NotificacionesPresWeb
  component "InsigniasPresWeb"              as InsigniasPresWeb
  component "InformesPresWeb"               as InformesPresWeb
  component "PanelPublicoPresWeb"           as PanelPublicoPresWeb

  interface "ILogicaUsuarios"               as RP_Usuarios
  interface "ILogicaServicioEntrenamiento"  as RP_ServicioEntrenamiento
  interface "ILogicaPersonas"               as RP_Personas
  interface "ILogicaInscripcionesYClases"   as RP_InscripcionesYClases
  interface "ILogicaHonorarios"             as RP_Honorarios
  interface "ILogicaCuotasPagos"            as RP_CuotasPagos
  interface "ILogicaRutinas"                as RP_Rutinas
  interface "ILogicaNotificaciones"         as RP_Notificaciones
  interface "ILogicaInsignias"              as RP_Insignias
  interface "ILogicaInformes"               as RP_Informes

  UsuarioPresWeb               -down-( RP_Usuarios
  ServicioEntrenamientoPresWeb -down-( RP_ServicioEntrenamiento
  PersonasPresWeb              -down-( RP_Personas
  InscripcionYClasesPresWeb    -down-( RP_InscripcionesYClases
  HonorariosPresWeb            -down-( RP_Honorarios
  CuotasPagosPresWeb           -down-( RP_CuotasPagos
  RutinasPresWeb               -down-( RP_Rutinas
  NotificacionesPresWeb        -down-( RP_Notificaciones
  InsigniasPresWeb             -down-( RP_Insignias
  InformesPresWeb              -down-( RP_Informes

  UsuarioPresWeb               -[hidden]right-> ServicioEntrenamientoPresWeb
  ServicioEntrenamientoPresWeb -[hidden]right-> PersonasPresWeb
  PersonasPresWeb              -[hidden]right-> InscripcionYClasesPresWeb
  InscripcionYClasesPresWeb    -[hidden]right-> HonorariosPresWeb
  HonorariosPresWeb            -[hidden]right-> CuotasPagosPresWeb
  CuotasPagosPresWeb           -[hidden]right-> RutinasPresWeb
  RutinasPresWeb               -[hidden]right-> NotificacionesPresWeb
  NotificacionesPresWeb        -[hidden]right-> InsigniasPresWeb
  InsigniasPresWeb             -[hidden]right-> InformesPresWeb
  InformesPresWeb              -[hidden]right-> PanelPublicoPresWeb

  note bottom of PanelPublicoPresWeb
    Página pública con datos fijos del front:
    no consume la API, así un visitante no
    despierta la API ni la base.
  end note
}

' ============================================================
' 2. CAPA DE LOGICA DE NEGOCIO PERSISTENTE
' ============================================================
package "Capa de Logica de Negocio Persistente" as CapaPersistente <<subsystem>> #F6DADA {

  ' ---------------- GestionUsuarios ----------------
  package "GestionUsuarios" as GestionUsuarios <<subsystem>> {
    component "Sesion"  as Sesion #EEFBF4
    component "Usuario" as Usuario
    component "Rol"     as Rol
    interface "IAutenticacion"           as I_Autenticacion
    interface "IAutenticacionGoogleAuth" as R_GU_GoogleAuth
    interface "IInfoUsuarios"            as I_InfoUsuarios
    interface "IAutorizacion"            as I_Autorizacion

    Sesion  -left- I_Autenticacion
    Sesion  -down-( R_GU_GoogleAuth
    Usuario -right- I_InfoUsuarios
    Rol     -right- I_Autorizacion
    Sesion  ..> Usuario
    Usuario ..> Rol
    Sesion  ..> Rol
  }
  interface "ILogicaUsuarios" as I_LogicaUsuarios
  GestionUsuarios -down- I_LogicaUsuarios
  note bottom of Sesion
    Los componentes resaltados
    de este color no se persisten
  end note

  ' ---------------- GestionServicioEntrenamiento ----------------
  package "GestionServicioEntrenamiento" as GestionServicioEntrenamiento <<subsystem>> {
    component "ParametrosSistema" as ParametrosSistema
    component "Plan"              as Plan
    component "Promocion"         as Promocion
    component "Actividad"         as Actividad
    component "Horario"           as Horario
    interface "IInfoParametros" as I_InfoParametros
    interface "IInfoPlanes"     as I_InfoPlanes
    interface "IInfoPromociones" as I_InfoPromociones
    interface "IInfoActividades" as I_InfoActividades
    interface "IInfoHorarios"   as I_InfoHorarios
    interface "IInfoProfesores" as R_GSE_InfoProfesores

    ParametrosSistema -down- I_InfoParametros
    Plan    -right- I_InfoPlanes
    Actividad -up- I_InfoActividades
    Horario -left- I_InfoHorarios
    Horario -right-( R_GSE_InfoProfesores
    Promocion -down- I_InfoPromociones
    Plan    ..> Promocion
    Plan    ..> Actividad
    Horario ..> Actividad
  }
  interface "ILogicaServicioEntrenamiento" as I_LogicaServicioEntrenamiento
  interface "IAutenticacion" as R_GSE_Aut
  interface "IAutorizacion"  as R_GSE_Autz
  interface "IInfoInscripciones" as R_GSE_InfoInscripciones
  GestionServicioEntrenamiento -down- I_LogicaServicioEntrenamiento
  GestionServicioEntrenamiento    -down-( R_GSE_Aut
  GestionServicioEntrenamiento   -down-( R_GSE_Autz
  GestionServicioEntrenamiento -down-( R_GSE_InfoInscripciones

  ' ---------------- GestionPersonas ----------------
  package "GestionPersonas" as GestionPersonas <<subsystem>> {
    component "Profesor" as Profesor
    component "Alumno"   as Alumno
    interface "IInfoProfesores" as I_InfoProfesores
    interface "IInfoAlumnos"    as I_InfoAlumnos

    Profesor -down- I_InfoProfesores
    Alumno   -up- I_InfoAlumnos
    Profesor -[hidden]down-> Alumno
  }
  interface "ILogicaPersonas" as I_LogicaPersonas
  interface "IAutorizacion"   as R_GP_Autz
  interface "IInfoUsuarios"   as R_GP_InfoUsuarios
  interface "IInfoHorarios"   as R_GP_InfoHorarios
  interface "IInfoInscripciones" as R_GP_InfoInscripciones
  interface "IInfoCuotas"     as R_GP_InfoCuotas
  interface "IAutenticacion"  as R_GP_Aut
  GestionPersonas       -down- I_LogicaPersonas
  GestionPersonas         -down-( R_GP_Autz
  GestionPersonas -down-( R_GP_InfoUsuarios
  GestionPersonas -down-( R_GP_InfoHorarios
  GestionPersonas -down-( R_GP_InfoInscripciones
  GestionPersonas -down-( R_GP_InfoCuotas
  GestionPersonas          -down-( R_GP_Aut

  ' ---------------- GestionRutinasYProgreso ----------------
  package "GestionRutinasYProgreso" as GestionRutinasYProgreso <<subsystem>> {
    component "RegistroProgreso" as RegistroProgreso
    component "Rutina"           as Rutina
    interface "IInfoProgreso"    as I_InfoProgreso
    RegistroProgreso -right- I_InfoProgreso
    RegistroProgreso -[hidden]down-> Rutina
  }
  interface "IInfoProfesores" as R_GRP_InfoProfesores
  interface "IInfoAlumnos"    as R_GRP_InfoAlumnos
  interface "IAutenticacion"  as R_GRP_Aut
  interface "IAutorizacion"   as R_GRP_Autz
  interface "ILogicaRutinas"  as I_LogicaRutinas
  GestionRutinasYProgreso -down-( R_GRP_InfoProfesores
  GestionRutinasYProgreso    -down-( R_GRP_InfoAlumnos
  GestionRutinasYProgreso            -down-( R_GRP_Aut
  GestionRutinasYProgreso           -down-( R_GRP_Autz
  GestionRutinasYProgreso         -down- I_LogicaRutinas

  ' ---------------- GestionCuotasYPagos ----------------
  package "GestionCuotasYPagos" as GestionCuotasYPagos <<subsystem>> {
    component "Cuota" as Cuota
    component "Pago"  as Pago
    interface "ICalculoVencimiento"  as R_GCP_CalculoVencimiento
    interface "IInfoInscripciones"   as R_GCP_InfoInscripciones
    interface "ICalculoHabilitacion" as R_GCP_CalculoHabilitacion
    interface "IInfoCuotas"          as I_InfoCuotas
    interface "IInfoPagos"           as I_InfoPagos
    interface "IInfoProfesores"      as R_GCP_InfoProfesores
    interface "IInfoPlanes"          as R_GCP_InfoPlanes
    interface "IInfoParametros"      as R_GCP_InfoParametros

    Cuota -right-( R_GCP_CalculoVencimiento
    Cuota -right-( R_GCP_InfoInscripciones
    Cuota -right-( R_GCP_InfoPlanes
    Cuota -down-( R_GCP_InfoParametros
    Cuota -down-( R_GCP_CalculoHabilitacion
    Cuota -down- I_InfoCuotas
    Pago  -up- I_InfoPagos
    Pago  -left-( R_GCP_InfoProfesores
    Cuota -[hidden]down-> Pago
    Pago  -[hidden]down-> GestionCuotasYPagos
  }
  interface "ILogicaCuotasPagos" as I_LogicaCuotasPagos
  interface "IAutenticacion"     as R_GCP_Aut
  interface "IAutorizacion"      as R_GCP_Autz
  GestionCuotasYPagos -down- I_LogicaCuotasPagos
  GestionCuotasYPagos    -down-( R_GCP_Aut
  GestionCuotasYPagos   -down-( R_GCP_Autz

  ' ---------------- GestionInscripcionesYClases ----------------
  package "GestionInscripcionesYClases" as GestionInscripcionesYClases <<subsystem>> {
    component "Inscripcion"      as Inscripcion
    component "Clase"            as Clase
    component "Suplencia"        as Suplencia
    component "Asistencia"       as Asistencia
    component "CierreAsistencia" as CierreAsistencia <<process>>
    interface "IInfoHorarios"      as R_GIC_InfoHorarios
    interface "IInfoProfesores"    as R_GIC_InfoProfesoresInsc
    interface "IInfoAlumnos"       as R_GIC_InfoAlumnos
    interface "IInfoPlanes"        as R_GIC_InfoPlanes
    interface "IInfoInscripciones" as I_InfoInscripciones
    interface "IInfoClases"        as I_InfoClases
    interface "IInfoProfesores"    as R_GIC_InfoProfesoresClase
    interface "IInfoHorarios"      as R_GIC_InfoHorariosClase
    interface "IInfoAsistencia"    as I_InfoAsistencia
    interface "IInfoParametros"    as R_GIC_InfoParametros
    interface "IInfoProgreso"      as R_GIC_InfoProgreso
    interface "IInfoParametros"    as R_GIC_InfoParametrosInsc
    interface "IInfoProfesores"    as R_GIC_InfoProfesoresSupl

    Inscripcion -left-( R_GIC_InfoHorarios
    Inscripcion -left-( R_GIC_InfoProfesoresInsc
    Inscripcion -left-( R_GIC_InfoAlumnos
    Inscripcion -left-( R_GIC_InfoPlanes
    Inscripcion -left-( R_GIC_InfoProgreso
    Inscripcion -left-( R_GIC_InfoParametrosInsc
    Inscripcion -down- I_InfoInscripciones
    Clase       -right- I_InfoClases
    Clase       -right-( R_GIC_InfoProfesoresClase
    Clase       -right-( R_GIC_InfoHorariosClase
    Asistencia  -right- I_InfoAsistencia
    CierreAsistencia -down-( R_GIC_InfoParametros
    Suplencia        -down-( R_GIC_InfoProfesoresSupl
    Suplencia        ..> Clase
    Asistencia       ..> Inscripcion
    Asistencia       ..> Clase
    CierreAsistencia ..> Asistencia
    CierreAsistencia ..> Clase
    Inscripcion -[hidden]right-> Clase
    Clase       -[hidden]right-> Suplencia
    Clase       -[hidden]down-> Asistencia
    Suplencia   -[hidden]down-> CierreAsistencia
    Asistencia  -[hidden]down-> GestionInscripcionesYClases
  }
  interface "ILogicaInscripcionesYClases" as I_LogicaInscripcionesYClases
  interface "IAutorizacion"  as R_GIC_Autz
  interface "IAutenticacion" as R_GIC_Aut
  interface "IInfoCuotas"    as R_GIC_InfoCuotas
  GestionInscripcionesYClases -down- I_LogicaInscripcionesYClases
  GestionInscripcionesYClases   -down-( R_GIC_Autz
  GestionInscripcionesYClases    -down-( R_GIC_Aut
  GestionInscripcionesYClases -down-( R_GIC_InfoCuotas

  ' ---------------- GestionNotificaciones ----------------
  package "GestionNotificaciones" as GestionNotificaciones <<subsystem>> {
    component "Notificacion"               as Notificacion
    component "PlanificadorNotificaciones" as PlanificadorNotificaciones <<process>>
    component "ResumenDiarioPropietaria"   as ResumenDiarioPropietaria <<process>>
    interface "IInfoUsuarios"   as R_GN_InfoUsuarios
    interface "IInfoClases"     as R_GN_InfoClases
    interface "IInfoParametros" as R_GN_InfoParametros
    interface "IInfoPagos"      as R_GN_InfoPagos
    interface "IInfoCuotas"     as R_GN_InfoCuotas
    interface "IRegistroNotificaciones" as I_RegistroNotificaciones

    Notificacion               -down- I_RegistroNotificaciones
    Notificacion               -right-( R_GN_InfoUsuarios
    PlanificadorNotificaciones -right-( R_GN_InfoClases
    PlanificadorNotificaciones -up-( R_GN_InfoParametros
    PlanificadorNotificaciones -up-( R_GN_InfoCuotas
    ResumenDiarioPropietaria   -up-( R_GN_InfoPagos
    ResumenDiarioPropietaria   -up-( R_GN_InfoCuotas
    ResumenDiarioPropietaria   -up-( R_GN_InfoParametros
    ResumenDiarioPropietaria   -( R_GN_InfoUsuarios
    PlanificadorNotificaciones ..> Notificacion
    ResumenDiarioPropietaria   ..> Notificacion
    Notificacion -[hidden]down-> PlanificadorNotificaciones
    PlanificadorNotificaciones -[hidden]right-> ResumenDiarioPropietaria
  }
  interface "IAutenticacion"        as R_GN_Aut
  interface "IAutorizacion"         as R_GN_Autz
  interface "ILogicaNotificaciones" as I_LogicaNotificaciones
  GestionNotificaciones    -down-( R_GN_Aut
  GestionNotificaciones   -down-( R_GN_Autz
  GestionNotificaciones -down- I_LogicaNotificaciones
  note top of PlanificadorNotificaciones
    Los componentes resaltados
    de este color son programados
  end note

  ' ---------------- GestionInsignias ----------------
  package "GestionInsignias" as GestionInsignias <<subsystem>> {
    component "Insignia" as Insignia
    component "CierreMensualInsignias" as CierreMensualInsignias <<process>>
    interface "IInfoAsistencia"      as R_GI_InfoAsistencia
    interface "ICalculoRachaRanking" as R_GI_CalculoRachaRanking
    interface "IInfoAlumnos"         as R_GI_InfoAlumnos
    interface "IInfoParametros"      as R_GI_InfoParametros
    interface "IOtorgamientoInsignias" as I_OtorgamientoInsignias

    Insignia -down- I_OtorgamientoInsignias
    CierreMensualInsignias -up-( I_OtorgamientoInsignias
    Insignia -right-( R_GI_InfoAsistencia
    Insignia -right-( R_GI_CalculoRachaRanking
    Insignia -left-( R_GI_InfoAlumnos
    Insignia -left-( R_GI_InfoParametros
    CierreMensualInsignias ..> Insignia
    Insignia -[hidden]down-> CierreMensualInsignias
  }
  interface "ILogicaInsignias" as I_LogicaInsignias
  interface "IAutorizacion"    as R_GI_Autz
  interface "IAutenticacion"   as R_GI_Aut
  GestionInsignias -down- I_LogicaInsignias
  GestionInsignias   -down-( R_GI_Autz
  GestionInsignias    -down-( R_GI_Aut

  ' ---------------- GestionHonorarios ----------------
  package "GestionHonorarios" as GestionHonorarios <<subsystem>> {
    component "Liquidacion"     as Liquidacion
    component "TarifaHonorario" as TarifaHonorario
    component "CierreMensualHonorarios" as CierreMensualHonorarios <<process>>
    interface "ICalculoHonorarios" as R_GH_CalculoHonorarios
    interface "IInfoClases"        as R_GH_InfoClases
    interface "IInfoInscripciones" as R_GH_InfoInscripciones
    interface "IInfoCuotas"        as R_GH_InfoCuotas
    interface "IInfoPlanes"        as R_GH_InfoPlanes
    interface "IInfoProfesores"    as R_GH_InfoProfesores
    interface "IInfoParametros"    as R_GH_InfoParametros
    interface "ICierreLiquidaciones" as I_CierreLiquidaciones

    Liquidacion     -left-( R_GH_CalculoHonorarios
    Liquidacion     -left-( R_GH_InfoClases
    Liquidacion     -right-( R_GH_InfoInscripciones
    Liquidacion     -right-( R_GH_InfoProfesores
    Liquidacion     -right-( R_GH_InfoCuotas
    TarifaHonorario -right-( R_GH_InfoPlanes
    TarifaHonorario -right-( R_GH_InfoProfesores
    Liquidacion ..> TarifaHonorario
    Liquidacion -down- I_CierreLiquidaciones
    CierreMensualHonorarios -up-( I_CierreLiquidaciones
    CierreMensualHonorarios -left-( R_GH_InfoParametros
    CierreMensualHonorarios ..> Liquidacion
    Liquidacion -[hidden]down-> CierreMensualHonorarios
  }
  interface "ILogicaHonorarios" as I_LogicaHonorarios
  interface "IAutorizacion"     as R_GH_Autz
  interface "IAutenticacion"    as R_GH_Aut
  GestionHonorarios -down- I_LogicaHonorarios
  GestionHonorarios   -down-( R_GH_Autz
  GestionHonorarios    -down-( R_GH_Aut


  ' Grilla de subsistemas (como en EA)
  GestionUsuarios              -[hidden]right-> GestionServicioEntrenamiento
  GestionServicioEntrenamiento -[hidden]right-> GestionPersonas
  GestionUsuarios              -[hidden]down->  GestionRutinasYProgreso
  GestionRutinasYProgreso      -[hidden]right-> GestionCuotasYPagos
  GestionCuotasYPagos          -[hidden]right-> GestionInscripcionesYClases
  GestionRutinasYProgreso      -[hidden]down->  GestionNotificaciones
  GestionNotificaciones        -[hidden]right-> GestionInsignias
  GestionInsignias             -[hidden]right-> GestionHonorarios
}
interface "IDesmaterializar" as R_Desmaterializar
interface "IMaterializar"    as R_Materializar
CapaPersistente -down-( R_Desmaterializar
CapaPersistente -down-( R_Materializar

' ============================================================
' 3. CAPA LOGICA DE NEGOCIO NO PERSISTENTE
' ============================================================
package "Capa Logica de Negocio No Persistente" as CapaNoPersistente <<subsystem>> #DDF7EC {

  ' ---------------- Calculos del negocio ----------------
  package "Calculos del negocio" as CalculosDelNegocio <<subsystem>> #F3FDF8 {
    component "CalculadorRachaRanking"     as CalcRacha #EEFBF4
    component "CalculadorVencimientoCuota" as CalcVenc #EEFBF4
    component "CalculadorHabilitacion"     as CalcHab #EEFBF4
    component "CalculadorHonorarios"       as CalcHon #EEFBF4
    interface "ICalculoRachaRanking" as I_CalculoRachaRanking
    interface "ICalculoVencimiento"  as I_CalculoVencimiento
    interface "ICalculoHabilitacion" as I_CalculoHabilitacion
    interface "ICalculoHonorarios"   as I_CalculoHonorarios

    CalcRacha -right- I_CalculoRachaRanking
    CalcVenc  -right- I_CalculoVencimiento
    CalcHab   -right- I_CalculoHabilitacion
    CalcHon   -right- I_CalculoHonorarios
    CalcRacha -[hidden]down-> CalcVenc
    CalcVenc  -[hidden]down-> CalcHab
    CalcHab   -[hidden]down-> CalcHon
  }

  ' ---------------- Reportes ----------------
  package "Reportes" as Reportes <<subsystem>> #F3FDF8 {
    component "GeneradorInformes"   as GeneradorInformes #EEFBF4
    component "DetectorInactividad" as DetectorInactividad #EEFBF4
    interface "IInfoAlumnos"       as R_RE_InfoAlumnos
    interface "IInfoHorarios"      as R_RE_InfoHorarios
    interface "IInfoPlanes"        as R_RE_InfoPlanes
    interface "IInfoInscripciones" as R_RE_InfoInscripciones
    interface "IInfoAsistencia"    as R_RE_InfoAsistencia
    interface "IInfoParametros"    as R_RE_InfoParametros
    interface "IInfoInscripciones" as R_RE_InfoInscripcionesDet
    interface "IInfoAlumnos"       as R_RE_InfoAlumnosDet
    interface "IInfoCuotas"        as R_RE_InfoCuotasDet
    interface "IInfoPagos"         as R_RE_InfoPagos
    interface "IInfoAsistencia"    as R_RE_InfoAsistenciaInf

    GeneradorInformes   -up-( R_RE_InfoAsistenciaInf
    GeneradorInformes   -right-( R_RE_InfoAlumnos
    GeneradorInformes   -right-( R_RE_InfoHorarios
    GeneradorInformes   -down-( R_RE_InfoPlanes
    GeneradorInformes   -down-( R_RE_InfoInscripciones
    GeneradorInformes   -down-( R_RE_InfoCuotasDet
    GeneradorInformes   -down-( R_RE_InfoPagos
    DetectorInactividad -up-( R_RE_InfoAsistencia
    DetectorInactividad -left-( R_RE_InfoParametros
    DetectorInactividad -down-( R_RE_InfoInscripcionesDet
    DetectorInactividad -down-( R_RE_InfoAlumnosDet
    DetectorInactividad -down-( R_RE_InfoCuotasDet
    GeneradorInformes ..> DetectorInactividad
  }
  interface "ILogicaInformes" as I_LogicaInformes
  interface "IAutenticacion"  as R_RE_Aut
  interface "IAutorizacion"   as R_RE_Autz
  interface "IInfoCuotas"     as R_RE_InfoCuotas
  Reportes     -down- I_LogicaInformes
  Reportes        -down-( R_RE_Aut
  Reportes       -down-( R_RE_Autz
  Reportes -down-( R_RE_InfoCuotas
  Reportes -down-( R_RE_InfoPagos

  CalculosDelNegocio -[hidden]down-> Reportes
}

' ============================================================
' 4. CAPA ADMINISTRACION DE DATOS
' ============================================================
package "Capa Administracion de Datos" as CapaDatos <<subsystem>> #F6DADA {
  component "Base de datos\nPostgreSQL" as BaseDeDatos
  component "Persistencia" as Persistencia <<subsystem>>
  interface "IMaterializar"    as I_Materializar
  interface "IDesmaterializar" as I_Desmaterializar

  Persistencia ..left-> BaseDeDatos
  Persistencia -right- I_Materializar
  Persistencia -right- I_Desmaterializar
}

' ============================================================
' 5. SISTEMAS EXTERNOS
' ============================================================
component "Google Auth" as GoogleAuth <<external>>
interface "IAutenticacionGoogleAuth" as I_GoogleAuth
GoogleAuth -up- I_GoogleAuth

' ============================================================
' Ubicacion relativa de las capas
' ============================================================
CapaPresentacion  -[hidden]down-> CapaPersistente
CapaPresentacion  -[hidden]down-> CapaNoPersistente
CapaPersistente   -[hidden]right-> CapaNoPersistente
CapaNoPersistente -[hidden]down-> CapaDatos
CapaDatos         -[hidden]down-> GoogleAuth

@enduml
