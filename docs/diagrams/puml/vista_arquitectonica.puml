@startuml Vista_Arquitectonica_MiFR
title Vista Arquitectonica del Diseno - Centro de Entrenamiento FR

skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundCorner 8
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 11
skinparam linetype ortho
skinparam nodesep 25
skinparam ranksep 45

skinparam package {
  BackgroundColor<<layer>> #F8F9FA
  BorderColor<<layer>> #495057
  BorderThickness<<layer>> 1.5
  FontColor<<layer>> #212529
  FontStyle<<layer>> bold

  BackgroundColor<<subsystem>> #FDE8E8
  BorderColor<<subsystem>> #C92A2A
  BorderThickness<<subsystem>> 1.2
  FontColor<<subsystem>> #212529
  FontStyle<<subsystem>> bold

  BackgroundColor<<subsystem_np>> #E7F0FA
  BorderColor<<subsystem_np>> #1971C2
  BorderThickness<<subsystem_np>> 1.2
  FontColor<<subsystem_np>> #212529
  FontStyle<<subsystem_np>> bold
}

skinparam component {
  BackgroundColor #FCDCDC
  BorderColor #C92A2A
  BorderThickness 1
  FontColor #212529

  BackgroundColor<<no_persistente>> #D0E2F4
  BorderColor<<no_persistente>> #1971C2
  BorderThickness<<no_persistente>> 1.2
  FontColor<<no_persistente>> #0C2D48

  BackgroundColor<<programado>> #FDF4E3
  BorderColor<<programado>> #D97706
  BorderThickness<<programado>> 1.2
  FontColor<<programado>> #78350F

  BackgroundColor<<fachada>> #FFFFFF
  BorderColor<<fachada>> #C92A2A
  BorderThickness<<fachada>> 2
  FontColor<<fachada>> #212529
  FontStyle<<fachada>> bold

  BackgroundColor<<externo>> #E6F4EA
  BorderColor<<externo>> #2F9E44
  BorderThickness<<externo>> 1.2
  FontColor<<externo>> #1B4332

  BackgroundColor<<presentacion>> #FFFFFF
  BorderColor<<presentacion>> #495057
}

skinparam interface {
  BackgroundColor #E9ECEF
  BorderColor #495057
  BorderThickness 1
  FontColor #212529
  FontSize 10
}

skinparam database {
  BackgroundColor #FFF3BF
  BorderColor #F59F00
  FontColor #212529
}

skinparam note {
  BackgroundColor #FEF9E7
  BorderColor #F59F00
  FontColor #333333
  FontSize 9
}

skinparam port {
  BorderColor #C92A2A
  BackgroundColor #FFFFFF
}

' ============================================================
' 1. CAPA PRESENTACION WEB
' ============================================================
package "CapaPresentacionWeb" as CapaPresentacionWeb <<layer>> {
  component "UsuariosPresWeb"       as UsuariosPresWeb      
  component "ConfiguracionPresWeb"  as ConfiguracionPresWeb 
  component "PlanesPreciosPresWeb"  as PlanesPreciosPresWeb 
  component "ActividadesPresWeb"    as ActividadesPresWeb   
  component "AlumnosPresWeb"        as AlumnosPresWeb       
  component "ProfesoresPresWeb"     as ProfesoresPresWeb    
  component "InscripcionesPresWeb"  as InscripcionesPresWeb 
  component "ClasesPresWeb"         as ClasesPresWeb        
  component "HonorariosPresWeb"     as HonorariosPresWeb    
  component "CuotasPagosPresWeb"    as CuotasPagosPresWeb   
  component "RutinasPresWeb"        as RutinasPresWeb       
  component "NotificacionesPresWeb" as NotificacionesPresWeb
  component "InsigniasPresWeb"      as InsigniasPresWeb  
  component "InformesPresWeb"       as InformesPresWeb      
  component "PanelPublicoPresWeb"   as PanelPublicoPresWeb  

  interface "IAutenticacion"        as IP_Autenticacion
  interface "ILogicaUsuarios"       as IP_Usuarios
  interface "ILogicaServicioEntrenamiento" as IP_ServicioEntrenamiento
  interface "ILogicaPersonas"       as IP_Personas
  interface "ILogicaInscripcionesYClases" as IP_InscripcionesYClases
  interface "ILogicaHonorarios"     as IP_Honorarios
  interface "ILogicaCuotasPagos"    as IP_CuotasPagos
  interface "ILogicaRutinas"        as IP_Rutinas
  interface "ILogicaNotificaciones" as IP_Notificaciones
  interface "ILogicaInsignia"       as IP_Insignia
  interface "ILogicaInformes"       as IP_Informes
  interface "ILogicaPanelPublico"   as IP_PanelPublico

  UsuariosPresWeb       --( IP_Autenticacion
  UsuariosPresWeb       --( IP_Usuarios
  ConfiguracionPresWeb  --( IP_ServicioEntrenamiento
  PlanesPreciosPresWeb  --( IP_ServicioEntrenamiento
  ActividadesPresWeb    --( IP_ServicioEntrenamiento
  AlumnosPresWeb        --( IP_Personas
  ProfesoresPresWeb     --( IP_Personas
  InscripcionesPresWeb  --( IP_InscripcionesYClases
  ClasesPresWeb         --( IP_InscripcionesYClases
  HonorariosPresWeb     --( IP_Honorarios
  CuotasPagosPresWeb    --( IP_CuotasPagos
  RutinasPresWeb        --( IP_Rutinas
  NotificacionesPresWeb --( IP_Notificaciones
  InsigniasPresWeb      --( IP_Insignia
  InformesPresWeb       --( IP_Informes
  PanelPublicoPresWeb   --( IP_PanelPublico

  UsuariosPresWeb       -[hidden]right-> ConfiguracionPresWeb
  ConfiguracionPresWeb  -[hidden]right-> PlanesPreciosPresWeb
  PlanesPreciosPresWeb  -[hidden]right-> ActividadesPresWeb
  ActividadesPresWeb    -[hidden]right-> AlumnosPresWeb
  AlumnosPresWeb        -[hidden]right-> ProfesoresPresWeb
  ProfesoresPresWeb     -[hidden]right-> InscripcionesPresWeb
  InscripcionesPresWeb  -[hidden]right-> ClasesPresWeb
  ClasesPresWeb         -[hidden]right-> HonorariosPresWeb
  HonorariosPresWeb     -[hidden]right-> CuotasPagosPresWeb
  CuotasPagosPresWeb    -[hidden]right-> RutinasPresWeb
  RutinasPresWeb        -[hidden]right-> NotificacionesPresWeb
  NotificacionesPresWeb -[hidden]right-> InsigniasPresWeb
  InsigniasPresWeb      -[hidden]right-> InformesPresWeb
  InformesPresWeb       -[hidden]right-> PanelPublicoPresWeb
}

' ============================================================
' 2. CAPA LOGICA DE NEGOCIO PERSISTENTE
' ============================================================
package "CapaLogicaNegocioPersistente" as CapaLogicaNegocioPersistente <<layer>> {

  ' ---------------- GestionUsuarios ----------------
  package "GestionUsuarios" as GestionUsuarios <<subsystem>> {
    interface "IAutenticacion"  as I_Autenticacion
    interface "ILogicaUsuarios" as I_LogicaUsuarios
    interface "IInfoUsuarios"   as I_InfoUsuarios
    interface "IAutenticacion\nGoogleAuth" as R_GU_GoogleAuth
    interface "IAutorizacion"   as I_Autorizacion

    component "Sesion"     as Sesion <<no_persistente>>
    component "Usuario"    as Usuario
    component "Rol"        as Rol

    Sesion   -up- I_Autenticacion
    Usuario  -up- I_LogicaUsuarios
    Usuario  -right- I_InfoUsuarios
    Sesion   -left( R_GU_GoogleAuth
    Rol      -down- I_Autorizacion

    Sesion   .right.> Usuario
    Usuario  .right.> Rol
  }

  ' ---------------- GestionServicioEntrenamiento ----------------
  package "GestionServicioEntrenamiento" as GestionServicioEntrenamiento <<subsystem>> {
    interface "ILogicaServicioEntrenamiento" as I_LogicaServicioEntrenamiento
    interface "IInfoPlanes"          as I_InfoPlanes
    interface "IInfoHorarios"        as I_InfoHorarios
    interface "IInfoParametros"      as I_InfoParametros
    interface "IInfoProfesores"      as R_GSE_InfoProfesores

    component "ParametroSistema" as ParametroSistema
    component "Plan"          as Plan
    component "Promocion"     as Promocion
    component "Actividad"     as Actividad
    component "Horario"       as Horario

    ParametroSistema -up- I_LogicaServicioEntrenamiento
    Plan             -up- I_LogicaServicioEntrenamiento
    Actividad        -up- I_LogicaServicioEntrenamiento
    ParametroSistema -down- I_InfoParametros
    Plan      -left- I_InfoPlanes
    Horario   -down- I_InfoHorarios
    Horario   -right( R_GSE_InfoProfesores

    Plan       .right.> Promocion
    Plan          ..> Actividad : exclusiva
    Horario       ..> Actividad

    ParametroSistema -[hidden]right-> Plan
    Plan       -[hidden]right-> Actividad
    Plan       -[hidden]down-> Promocion
    Actividad  -[hidden]down-> Horario

    portout " " as p_aut_gse
    portout " " as p_autz_gse
    Horario -[hidden]down-> p_aut_gse
    p_aut_gse -[hidden]right-> p_autz_gse
  }

  interface "IAutenticacion" as I_Aut_GSE
  interface "IAutorizacion"  as I_Autz_GSE
  p_aut_gse  -down-( I_Aut_GSE
  p_autz_gse -down-( I_Autz_GSE

  ' ---------------- GestionPersonas ----------------
  package "GestionPersonas" as GestionPersonas <<subsystem>> {
    interface "ILogicaPersonas"      as I_LogicaPersonas
    interface "IInfoAlumnos"        as I_InfoAlumnos
    interface "IInfoProfesores"     as I_InfoProfesores
    interface "IInfoUsuarios"       as R_GP_InfoUsuarios

    component "Alumno"   as Alumno
    component "Profesor" as Profesor

    Alumno   -up- I_LogicaPersonas
    Profesor -up- I_LogicaPersonas
    Alumno   -down- I_InfoAlumnos
    Profesor -down- I_InfoProfesores

    portout " " as p_infousuarios_gp
    p_infousuarios_gp -down-( R_GP_InfoUsuarios
    Alumno   -[hidden]up-> p_infousuarios_gp
    Profesor -[hidden]up-> p_infousuarios_gp

    Alumno   -[hidden]right-> Profesor

    portout " " as p_aut_gp
    portout " " as p_autz_gp
    Profesor -[hidden]down-> p_aut_gp
    p_aut_gp -[hidden]right-> p_autz_gp
  }

  interface "IAutenticacion" as I_Aut_GP
  interface "IAutorizacion"  as I_Autz_GP
  p_aut_gp  -down-( I_Aut_GP
  p_autz_gp -down-( I_Autz_GP

  ' ---------------- GestionInscripcionesYClases ----------------
  package "GestionInscripcionesYClases" as GestionInscripcionesYClases <<subsystem>> {
    interface "ILogicaInscripcionesYClases" as I_LogicaInscripcionesYClases
    interface "IInfoInscripciones"   as I_InfoInscripciones
    interface "IInfoClases"          as I_InfoClases
    interface "IInfoAsistencia"      as I_InfoAsistencia
    interface "IInfoAlumnos"         as R_GIC_InfoAlumnos
    interface "IInfoPlanes"          as R_GIC_InfoPlanes
    interface "IInfoProfesores"      as R_GIC_InfoProfesores
    interface "IInfoHorarios"        as R_GIC_InfoHorarios
    interface "ICalculoCupo"         as R_GIC_CalculoCupo
    interface "IInfoParametros"      as R_GIC_InfoParametros

    component "Inscripcion"        as Inscripcion
    component "Clase"              as Clase
    component "Suplencia"          as Suplencia
    component "Asistencia"         as Asistencia
    component "CierreAsistencia"   as CierreAsistencia <<programado>>

    Inscripcion -up- I_LogicaInscripcionesYClases
    Clase       -up- I_LogicaInscripcionesYClases
    Inscripcion -left- I_InfoInscripciones
    Clase       -right- I_InfoClases
    Asistencia  -right- I_InfoAsistencia

    Inscripcion        -left( R_GIC_InfoAlumnos
    Inscripcion        -left( R_GIC_InfoPlanes
    Inscripcion        -left( R_GIC_InfoHorarios
    Inscripcion        -down( R_GIC_CalculoCupo
    Clase              -right( R_GIC_InfoProfesores
    CierreAsistencia   -down( R_GIC_InfoParametros

    Suplencia          ..> Clase
    Asistencia         ..> Clase
    Asistencia         ..> Inscripcion
    CierreAsistencia   ..> Asistencia

    Inscripcion -[hidden]right-> Clase
    Clase       -[hidden]down-> Suplencia
    Suplencia   -[hidden]right-> Asistencia
    Asistencia  -[hidden]down-> CierreAsistencia

    portout " " as p_aut_gic
    portout " " as p_autz_gic
    CierreAsistencia -[hidden]down-> p_aut_gic
    p_aut_gic -[hidden]right-> p_autz_gic
  }

  interface "IAutenticacion" as I_Aut_GIC
  interface "IAutorizacion"  as I_Autz_GIC
  p_aut_gic  -down-( I_Aut_GIC
  p_autz_gic -down-( I_Autz_GIC

  ' ---------------- GestionHonorarios ----------------
  package "GestionHonorarios" as GestionHonorarios <<subsystem>> {
    interface "ILogicaHonorarios"  as I_LogicaHonorarios
    interface "ICalculoHonorarios" as R_GH_CalculoHonorarios
    interface "IInfoCuotas"        as R_GH_InfoCuotas
    interface "IInfoInscripciones" as R_GH_InfoInscripciones
    interface "IInfoClases"        as R_GH_InfoClases
    interface "IInfoProfesores"    as R_GH_InfoProfesores
    interface "IInfoPlanes"        as R_GH_InfoPlanes

    component "Liquidacion"        as Liquidacion
    component "TarifaHonorario"    as TarifaHonorario

    Liquidacion        -up- I_LogicaHonorarios
    Liquidacion        -right( R_GH_CalculoHonorarios
    Liquidacion        -left( R_GH_InfoCuotas
    Liquidacion        -left( R_GH_InfoInscripciones
    Liquidacion        -down( R_GH_InfoClases
    TarifaHonorario    -right( R_GH_InfoProfesores
    TarifaHonorario    -down( R_GH_InfoPlanes

    Liquidacion ..> TarifaHonorario
    Liquidacion -[hidden]right-> TarifaHonorario

    portout " " as p_aut_gh
    portout " " as p_autz_gh
    TarifaHonorario -[hidden]down-> p_aut_gh
    p_aut_gh -[hidden]right-> p_autz_gh
  }

  interface "IAutenticacion" as I_Aut_GH
  interface "IAutorizacion"  as I_Autz_GH
  p_aut_gh  -down-( I_Aut_GH
  p_autz_gh -down-( I_Autz_GH

  ' ---------------- GestionCuotasYPagos ----------------
  package "GestionCuotasYPagos" as GestionCuotasYPagos <<subsystem>> {
    interface "ILogicaCuotasPagos"   as I_LogicaCuotasPagos
    interface "IInfoCuotas"          as I_InfoCuotas
    interface "IInfoPagos"           as I_InfoPagos
    interface "ICalculoVencimiento"  as R_GCP_CalculoVencimiento
    interface "ICalculoHabilitacion" as R_GCP_CalculoHabilitacion
    interface "IInfoInscripciones"   as R_GCP_InfoInscripciones
    interface "IInfoProfesores"      as R_GCP_InfoProfesores

    component "Pago"  as Pago
    component "Cuota" as Cuota

    Pago  -up- I_LogicaCuotasPagos
    Cuota -up- I_LogicaCuotasPagos
    Pago  -right- I_InfoPagos
    Cuota -right- I_InfoCuotas
    Pago  -left( R_GCP_InfoProfesores
    Cuota -left( R_GCP_InfoInscripciones
    Cuota -down( R_GCP_CalculoVencimiento
    Cuota -down( R_GCP_CalculoHabilitacion

    Pago ..> Cuota

    portout " " as p_aut_gcp
    portout " " as p_autz_gcp
    Cuota -[hidden]down-> p_aut_gcp
    p_aut_gcp -[hidden]right-> p_autz_gcp
  }

  interface "IAutenticacion" as I_Aut_GCP
  interface "IAutorizacion"  as I_Autz_GCP
  p_aut_gcp  -down-( I_Aut_GCP
  p_autz_gcp -down-( I_Autz_GCP

  ' ---------------- GestionRutinasYProgreso ----------------
  package "GestionRutinasYProgreso" as GestionRutinasYProgreso <<subsystem>> {
    interface "ILogicaRutinas"  as I_LogicaRutinas
    interface "IInfoAlumnos"    as R_GRP_InfoAlumnos
    interface "IInfoProfesores" as R_GRP_InfoProfesores

    component "Rutina"           as Rutina
    component "RegistroProgreso" as RegistroProgreso

    Rutina           -up- I_LogicaRutinas
    RegistroProgreso -up- I_LogicaRutinas

    portout " " as p_infoalumnos_grp
    portout " " as p_infoprofesores_grp
    p_infoalumnos_grp    -down-( R_GRP_InfoAlumnos
    p_infoprofesores_grp -down-( R_GRP_InfoProfesores
    Rutina           -[hidden]up-> p_infoalumnos_grp
    RegistroProgreso -[hidden]up-> p_infoalumnos_grp
    Rutina           -[hidden]up-> p_infoprofesores_grp
    RegistroProgreso -[hidden]up-> p_infoprofesores_grp

    Rutina           -[hidden]right-> RegistroProgreso

    portout " " as p_aut_grp
    portout " " as p_autz_grp
    RegistroProgreso -[hidden]down-> p_aut_grp
    p_aut_grp -[hidden]right-> p_autz_grp
  }

  interface "IAutenticacion" as I_Aut_GRP
  interface "IAutorizacion"  as I_Autz_GRP
  p_aut_grp  -down-( I_Aut_GRP
  p_autz_grp -down-( I_Autz_GRP

  ' ---------------- GestionNotificaciones ----------------
  package "GestionNotificaciones" as GestionNotificaciones <<subsystem>> {
    interface "ILogicaNotificaciones" as I_LogicaNotificaciones
    interface "IInfoUsuarios"         as R_GN_InfoUsuarios
    interface "IInfoCuotas"           as R_GN_InfoCuotas
    interface "IInfoPagos"            as R_GN_InfoPagos
    interface "IInfoClases"           as R_GN_InfoClases
    interface "IInfoParametros"       as R_GN_InfoParametros

    component "Notificacion"               as Notificacion
    component "PlanificadorNotificaciones" as PlanificadorNotificaciones <<programado>>
    component "ResumenDiarioPropietaria"   as ResumenDiarioPropietaria <<programado>>

    Notificacion -up- I_LogicaNotificaciones

    Notificacion   -left( R_GN_InfoUsuarios
    PlanificadorNotificaciones -down( R_GN_InfoClases
    PlanificadorNotificaciones -down( R_GN_InfoParametros
    ResumenDiarioPropietaria   -down( R_GN_InfoPagos

    portout " " as p_infocuotas_gn
    p_infocuotas_gn -down-( R_GN_InfoCuotas
    PlanificadorNotificaciones -[hidden]up-> p_infocuotas_gn
    ResumenDiarioPropietaria   -[hidden]up-> p_infocuotas_gn

    PlanificadorNotificaciones ..> Notificacion
    ResumenDiarioPropietaria   ..> Notificacion

    Notificacion -[hidden]down-> PlanificadorNotificaciones
    PlanificadorNotificaciones -[hidden]right-> ResumenDiarioPropietaria

    portout " " as p_aut_gn
    portout " " as p_autz_gn
    ResumenDiarioPropietaria -[hidden]down-> p_aut_gn
    p_aut_gn -[hidden]right-> p_autz_gn
  }

  interface "IAutenticacion" as I_Aut_GN
  interface "IAutorizacion"  as I_Autz_GN
  p_aut_gn  -down-( I_Aut_GN
  p_autz_gn -down-( I_Autz_GN

  ' ---------------- GestionInsignias ----------------
  package "GestionInsignias" as GestionInsignias <<subsystem>> {
    interface "ILogicaInsignia"       as I_LogicaInsignia
    interface "IInfoAsistencia"       as R_GI_InfoAsistencia
    interface "ICalculoRachaRanking"  as R_GI_CalculoRachaRanking

    component "Insignia" as Insignia

    Insignia -up- I_LogicaInsignia
    Insignia -right( R_GI_InfoAsistencia
    Insignia -right( R_GI_CalculoRachaRanking

    portout " " as p_aut_gi
    portout " " as p_autz_gi
    Insignia -[hidden]down-> p_aut_gi
    p_aut_gi -[hidden]right-> p_autz_gi
  }

  interface "IAutenticacion" as I_Aut_GI
  interface "IAutorizacion"  as I_Autz_GI
  p_aut_gi  -down-( I_Aut_GI
  p_autz_gi -down-( I_Autz_GI

  ' Orden horizontal de subsistemas
  GestionUsuarios              -[hidden]right-> GestionServicioEntrenamiento
  GestionServicioEntrenamiento -[hidden]right-> GestionPersonas
  GestionPersonas              -[hidden]right-> GestionInscripcionesYClases
  GestionInscripcionesYClases  -[hidden]right-> GestionHonorarios
  GestionHonorarios            -[hidden]right-> GestionCuotasYPagos
  GestionCuotasYPagos          -[hidden]right-> GestionRutinasYProgreso
  GestionRutinasYProgreso      -[hidden]right-> GestionNotificaciones
  GestionNotificaciones        -[hidden]right-> GestionInsignias

  ' Puertos hacia la capa de administracion de datos
  portout " " as port_des
  portout " " as port_mat
}

' ============================================================
' 3. CAPA LOGICA DE NEGOCIO NO PERSISTENTE
' ============================================================
package "CapaLogicaNegocioNoPersistente" as CapaLogicaNegocioNoPersistente <<layer>> {

  package "CalculosDeNegocio" as CalculosDeNegocio <<subsystem_np>> {
    interface "ICalculoVencimiento"  as I_CalculoVencimiento
    interface "ICalculoHabilitacion" as I_CalculoHabilitacion
    interface "ICalculoCupo"         as I_CalculoCupo
    interface "ICalculoHonorarios"   as I_CalculoHonorarios
    interface "ICalculoRachaRanking" as I_CalculoRachaRanking

    component "CalculadorVencimientoCuota" as CalcVenc    <<no_persistente>>
    component "CalculadorHabilitacion"     as CalcHab     <<no_persistente>>
    component "CalculadorCupo"             as CalcCupo    <<no_persistente>>
    component "CalculadorHonorarios"       as CalcHon     <<no_persistente>>
    component "CalculadorRachaRanking"     as CalcRacha   <<no_persistente>>

    CalcVenc  -up- I_CalculoVencimiento
    CalcHab   -up- I_CalculoHabilitacion
    CalcCupo  -up- I_CalculoCupo
    CalcHon   -up- I_CalculoHonorarios
    CalcRacha -up- I_CalculoRachaRanking

    CalcVenc -[hidden]right-> CalcHab
    CalcHab  -[hidden]right-> CalcCupo
    CalcCupo -[hidden]right-> CalcHon
    CalcHon  -[hidden]right-> CalcRacha
  }

  package "Reportes" as ReportesYEstadisticas <<subsystem_np>> {
    interface "ILogicaInformes"     as I_LogicaInformes
    interface "IInfoAsistencia"     as R_RE_InfoAsistencia
    interface "IInfoCuotas"         as R_RE_InfoCuotas
    interface "IInfoAlumnos"        as R_RE_InfoAlumnos
    interface "IInfoParametros"     as R_RE_InfoParametros
    interface "IInfoInscripciones"  as R_RE_InfoInscripciones
    interface "IInfoPlanes"         as R_RE_InfoPlanes
    interface "IInfoHorarios"       as R_RE_InfoHorarios

    component "GeneradorInformes"            as GeneradorInformes            <<no_persistente>>
    component "DetectorInactividad" as DetectorInactividad <<no_persistente>>

    GeneradorInformes -up- I_LogicaInformes
    GeneradorInformes ..> DetectorInactividad

    GeneradorInformes            -left( R_RE_InfoAlumnos
    GeneradorInformes            -down( R_RE_InfoPlanes
    GeneradorInformes            -down( R_RE_InfoInscripciones
    GeneradorInformes            -down( R_RE_InfoHorarios
    DetectorInactividad -down( R_RE_InfoAsistencia
    DetectorInactividad -down( R_RE_InfoParametros

    portout " " as p_infocuotas_re
    p_infocuotas_re -down-( R_RE_InfoCuotas
    GeneradorInformes   -[hidden]up-> p_infocuotas_re
    DetectorInactividad -[hidden]up-> p_infocuotas_re

    GeneradorInformes -[hidden]right-> DetectorInactividad

    portout " " as p_aut_re
    portout " " as p_autz_re
  }
  interface "IAutenticacion" as I_Aut_RE
  interface "IAutorizacion"  as I_Autz_RE
  p_aut_re  -down-( I_Aut_RE
  p_autz_re -down-( I_Autz_RE

  package "DifusionPublica" as DifusionPublica <<subsystem_np>> {
    interface "ILogicaPanelPublico" as I_LogicaPanelPublico
    interface "IInfoHorarios"       as R_DP_InfoHorarios
    interface "IInfoInscripciones"  as R_DP_InfoInscripciones
    interface "IInfoPlanes"         as R_DP_InfoPlanes
    interface "ICalculoCupo"        as R_DP_CalculoCupo

    component "PanelDisponibilidad" as PanelDisponibilidad <<no_persistente>>

    PanelDisponibilidad -up- I_LogicaPanelPublico
    PanelDisponibilidad -down( R_DP_InfoHorarios
    PanelDisponibilidad -down( R_DP_InfoInscripciones
    PanelDisponibilidad -down( R_DP_InfoPlanes
    PanelDisponibilidad -down( R_DP_CalculoCupo
  }

  note bottom of DifusionPublica
    Acceso publico:
    no requiere autenticacion
  end note

  CalculosDeNegocio     -[hidden]down-> ReportesYEstadisticas
  ReportesYEstadisticas -[hidden]right-> DifusionPublica
}

' ============================================================
' 4. SISTEMAS EXTERNOS
' ============================================================
package "SistemasExternos" as SistemasExternos <<layer>> {
  interface "IAutenticacion\nGoogleAuth" as IE_GoogleAuth

  component "Google Identity Services"    as GoogleIdentity <<externo>>

  GoogleIdentity -up- IE_GoogleAuth

  note bottom of GoogleIdentity
    Usado para el login
    (US-01)
  end note
}

' ============================================================
' 5. CAPA DE ADMINISTRACION DE DATOS
' ============================================================
package "CapaAdministracionDatos" as CapaAdministracionDatos <<layer>> {
  interface "IDesmaterializar" as IA_Desmaterializar
  interface "IMaterializar"    as IA_Materializar

  component "Persistencia" as Persistencia <<subsystem>>
  database "PostgreSQL"    as BaseDeDatos

  IA_Desmaterializar -down- Persistencia
  IA_Materializar    -down- Persistencia
  Persistencia ..right-> BaseDeDatos
  IA_Desmaterializar -[hidden]right-> IA_Materializar

  note right of Persistencia
    Realizado por Prisma Client
  end note
}

