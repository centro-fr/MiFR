DATABASE_URL="postgresql://user:password@localhost:55432/mifr?schema=public"

# OAuth Client ID de Google (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"

# Secreto para firmar los JWT propios emitidos tras validar el login con Google. Obligatorio; con
# NODE_ENV=production tiene que tener al menos 32 caracteres o la API no arranca.
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Puerto de la API (por defecto 3000)
PORT=3000

# Interfaz en la que escucha la API. Por defecto 127.0.0.1 fuera de producción (solo la propia máquina:
# con el login de desarrollo activo no conviene exponerla a la red local) y 0.0.0.0 en producción.
# HOST=127.0.0.1

# development publica Swagger en /api/v1/docs. El contenedor usa production si no se define.
NODE_ENV="development"

# Orígenes que pueden llamar a la API, separados por comas. Obligatoria con NODE_ENV=production.
# CORS_ORIGENES="https://mifr.netlify.app,http://localhost:5173"

# Cuántos proxies hay delante de la API (de 0 a 5). Con eso Express sabe cuál es la IP del visitante,
# que es lo que cuenta el límite de pedidos. En local no hay ninguno: 0, el valor por defecto.
# Obligatoria con NODE_ENV=production; en Render se calibra como dice back/DESPLIEGUE.md.
# PROXIES_DE_CONFIANZA=0

# Secreto con el que Netlify firma los pedidos que reenvía a la API (signed en netlify.toml). Con valor,
# la API rechaza con 403 lo que no traiga esa firma. Obligatoria con NODE_ENV=production, de al menos
# 32 caracteres; en local se deja sin definir, porque el proxy de Vite no firma.
# FIRMA_PROXY_NETLIFY=

# Solo desarrollo: habilita POST /api/v1/auth/desarrollo para entrar con el email de un usuario
# dado de alta, sin Google. Con NODE_ENV=production la API no arranca si está en true.
LOGIN_DESARROLLO=true