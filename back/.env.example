DATABASE_URL="postgresql://user:password@localhost:55432/mifr?schema=public"

# OAuth Client ID de Google (Google Cloud Console > Credentials)
GOOGLE_CLIENT_ID="xxxxxxxxxx.apps.googleusercontent.com"

# Secreto para firmar los JWT propios emitidos tras validar el login con Google
JWT_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# Puerto de la API (por defecto 3000)
PORT=3000

# development publica Swagger en /api/v1/docs. El contenedor usa production si no se define.
NODE_ENV="development"

# Orígenes que pueden llamar a la API, separados por comas. Obligatoria con NODE_ENV=production.
# CORS_ORIGENES="https://mifr.netlify.app,http://localhost:5173"
