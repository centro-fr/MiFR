# Dependencias (todas las de front y back, en el node_modules compartido)
node_modules/

# El monorepo usa pnpm (pnpm-lock.yaml): un lockfile de npm o yarn quedaría desincronizado.
package-lock.json
yarn.lock

# Builds compilados
dist/
build/

# Variables de entorno
.env
.env.*
!.env.example

# Prisma
back/prisma/*.db
back/prisma/migrations/dev.db*

# Resultados de Playwright (capturas y videos de front/e2e): cada corrida los vuelve a generar.
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / SO
.DS_Store
.vscode/
.idea/
.claude/

# Cobertura de tests
coverage/

# Vite (cache local del front)
front/.vite/

# Archivos de bloqueo de Enterprise Architect
*.ldb

user09y10/

# Capturas de pantalla temporales de chat / diseño
/*.png
/*.jpg
/*.jpeg
front/*.png
front/*.jpg
front/*.jpeg
